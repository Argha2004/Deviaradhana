# Cloudflare R2 Configuration
# Replace with your Cloudflare R2 public bucket URL (e.g., https://pub-xxxx.r2.dev or https://cdn.yourdomain.com)
VITE_R2_PUBLIC_URL=https://pub-example.r2.dev

# Optional: If you use a Go backend API endpoint to serve songs and metadata
VITE_API_URL=http://localhost:8080/api
